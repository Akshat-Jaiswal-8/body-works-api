#!/usr/bin/env sh
set -e

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|js|mjs|cjs|json|md|yml|yaml|prisma)$' || true)
CODE_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|js|mjs|cjs)$' || true)

if [ -n "$STAGED_FILES" ]; then
  echo "Formatting staged files..."
  echo "$STAGED_FILES" | xargs npx prettier --write --cache
  echo "$STAGED_FILES" | xargs git add
fi

echo "Running typecheck..."
npm run typecheck
