{
  "info": {
    "name": "Body Works API",
    "description": "Comprehensive Postman collection for the Body Works API. Includes auth flow, protected routes, filtering examples, and automated token capture.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": ["pm.variables.set('requestStartedAt', new Date().toISOString());"]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response time is less than 5000ms', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "apiBaseUrl",
      "value": "{{baseUrl}}/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "exerciseId",
      "value": "0001"
    },
    {
      "key": "routineId",
      "value": "1"
    },
    {
      "key": "limit",
      "value": "10"
    },
    {
      "key": "page",
      "value": "1"
    },
    {
      "key": "equipment",
      "value": "body weight"
    },
    {
      "key": "target",
      "value": "abs"
    },
    {
      "key": "bodyPart",
      "value": "waist"
    },
    {
      "key": "search",
      "value": "push"
    },
    {
      "key": "routineFilter",
      "value": "category"
    }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Health payload has status and timestamp', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('status', 'OK');",
                  "  pm.expect(json).to.have.property('timestamp');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Root payload includes service metadata', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('message');",
                  "  pm.expect(json).to.have.property('version');",
                  "  pm.expect(json).to.have.property('status');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test.user@example.com\",\n  \"phone_number\": \"+919876543210\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{apiBaseUrl}}/auth/register",
              "host": ["{{apiBaseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 for new user or 200/409 for existing user', function () {",
                  "  pm.expect([200, 201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test.user@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{apiBaseUrl}}/auth/login",
              "host": ["{{apiBaseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Login returns access token and user details', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('data');",
                  "  pm.expect(json.data).to.have.property('accessToken');",
                  "  pm.expect(json.data).to.have.property('id');",
                  "  pm.expect(json.data).to.have.property('email');",
                  "});",
                  "pm.test('Store auth variables for protected routes', function () {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "  pm.collectionVariables.set('userId', json.data.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/auth/refresh-token",
              "host": ["{{apiBaseUrl}}"],
              "path": ["auth", "refresh-token"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 when refresh cookie is valid', function () {",
                  "  pm.expect([200, 401, 403]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Refresh updates access token', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('data');",
                  "    pm.expect(json.data).to.have.property('accessToken');",
                  "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "    if (json.data.id) pm.collectionVariables.set('userId', json.data.id);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/auth/logout",
              "host": ["{{apiBaseUrl}}"],
              "path": ["auth", "logout"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Clears access token variable after logout', function () {",
                  "  pm.collectionVariables.set('accessToken', '');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Exercises",
      "item": [
        {
          "name": "Get Exercises (Protected)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/exercises?page={{page}}&limit={{limit}}&equipment={{equipment}}&target={{target}}&bodyPart={{bodyPart}}&search={{search}}",
              "host": ["{{apiBaseUrl}}"],
              "path": ["exercises"],
              "query": [
                {
                  "key": "page",
                  "value": "{{page}}"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}"
                },
                {
                  "key": "equipment",
                  "value": "{{equipment}}"
                },
                {
                  "key": "target",
                  "value": "{{target}}"
                },
                {
                  "key": "bodyPart",
                  "value": "{{bodyPart}}"
                },
                {
                  "key": "search",
                  "value": "{{search}}"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is one of expected auth-aware outcomes', function () {",
                  "  pm.expect([200, 401, 403]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Exercises payload includes pagination and data array', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('totalExercises');",
                  "    pm.expect(json).to.have.property('totalPages');",
                  "    pm.expect(json).to.have.property('data');",
                  "    pm.expect(json.data).to.be.an('array');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Exercise By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/exercises/{{exerciseId}}",
              "host": ["{{apiBaseUrl}}"],
              "path": ["exercises", "{{exerciseId}}"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 or 404 for invalid id', function () {",
                  "  pm.expect([200, 404]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Exercise payload contains data object', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('data');",
                  "    pm.expect(json.data).to.be.an('object');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
